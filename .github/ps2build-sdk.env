# Official ps2build releases pinned from https://raw.githubusercontent.com/ps2build/manifest/main/latest.json
# Resolved 2026-11-21. The CI build uses GCC; LLVM remains pinned for a future explicit compiler job.
PS2BUILD_SDK_RESOLVED=1
# tools/install_ports.py does not implement PS2BUILD_SDK_NO_FALLBACK. Keep its possible fallback
# confined to the official ps2build organization rather than NathanNeurotic/old-ps2build-mirror.
PS2BUILD_SDK_MIRROR=ps2build/ps2build
PS2BUILD_SDK_TAG=
PS2BUILD_SDK_SUMS_SHA256=
PS2BUILD_COMPONENTS="ps2build=v2026.11.11 sdk-core=v2026.11.11 sdk-world=v2026.11.05 toolchain=v2026.11.04 tools=v2026.11.04 vcl=v2026.11.04 ninja=v1.13.2 cmake=v2026.11.04"
PS2BUILD_LLVM_TOOLCHAIN=v2026.11.11
PS2BUILD_EXTRAS=""
PS2BUILD_EXTRAS_TAG=
PS2BUILD_EXTRAS_SUMS_SHA256=
OGG_VERSION=v2026.11.11
VORBIS_VERSION=v2026.11.11
